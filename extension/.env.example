# Orbit Extension 환경변수 예시 (실제 .env 는 커밋 금지)

# 백엔드 API 주소 (개발: 로컬, 배포: 실제 서버 URL)
VITE_API_BASE_URL=http://localhost:8000

# 구글 로그인 OAuth 클라이언트 ID
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID
#   애플리케이션 유형: "Chrome 확장 프로그램"
#   항목 ID: aghgamoeifieijjckhpfkmhiibacnhml (wxt.config.ts 의 key 로 고정 — 아래 참고)
# 백엔드 .env 의 GOOGLE_CLIENT_ID 와 같은 값이어야 한다.
VITE_GOOGLE_CLIENT_ID=

# ── 확장 ID 는 여기서 설정하지 않는다 ─────────────────────────────────
# manifest 의 key(공개키)가 wxt.config.ts 에 커밋되어 있어 dev·build·모든 팀원 머신에서
# 확장 ID 가 aghgamoeifieijjckhpfkmhiibacnhml 로 동일하다. 따로 채울 값이 없다.
#
# 팀원이 처음 세팅할 때 필요한 것은 위 두 값뿐이며, 추가로 Google Cloud Console 의
# "OAuth 동의 화면 > 대상(테스트 사용자)" 에 본인 구글 계정이 등록되어 있어야 한다.
# 등록되지 않은 계정은 로그인 시 403 access_denied 로 거부된다.
