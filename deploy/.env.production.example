# Orbit 공용 서버 비밀값. 키 이름만 적는다 — 값은 서버의 deploy/.env.production 에만 둔다.
#   cp .env.production.example .env.production && chmod 600 .env.production
# 저장소·채팅·스크린샷에 값을 올리지 않는다. 자세한 것은 docs/deploy.md '비밀값'.

# ── 주소와 인증서 ─────────────────────────────────────────────
# 서버 호스트명(예: orbit.example.com). Caddy 가 이 이름으로 Let's Encrypt 인증서를 받는다.
ORBIT_DOMAIN=
# Let's Encrypt 만료 알림 주소
ACME_EMAIL=

# ── 데이터스토어 ──────────────────────────────────────────────
# URL 에 그대로 들어가므로 영숫자만 쓴다: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# ── AI 공급자 ─────────────────────────────────────────────────
AXK1_API_KEY=
# 아래 둘은 기본값을 바꿀 때만 주석을 푼다. 빈 값으로 두면 기본값 대신 빈 문자열이 들어간다.
# AXK1_BASE_URL=
# AXK1_MODEL=
FRIENDLI_API_KEY=
# FRIENDLI_BASE_URL=
# EXAONE_MODEL=
# KT — 폴백. 모델명은 KT_MODEL_NAME(예전 KT_MODEL 은 읽지 않는다).
KT_API_KEY=
# KT_BASE_URL=
# KT_MODEL_NAME=
UPSTAGE_API_KEY=

# ── 로그인 ────────────────────────────────────────────────────
# 확장의 VITE_GOOGLE_CLIENT_ID 와 같은 값(Chrome 확장 유형 OAuth 클라이언트)
GOOGLE_CLIENT_ID=
# 공용 서버 전용 값을 새로 만든다(로컬 개발 값 재사용 금지):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# ── 배치 ──────────────────────────────────────────────────────
# 공용 서버는 개수 트리거 외에 주기 세션화도 켠다(0 = 끔)
SYNC_INTERVAL_MINUTES=10

# ── CORS (제품 코드 반영 뒤 유효, docs/deploy.md 'CORS') ──────
# 쉼표로 구분. 기본은 고정 확장 ID 하나.
CORS_ALLOW_ORIGINS=chrome-extension://aghgamoeifieijjckhpfkmhiibacnhml
