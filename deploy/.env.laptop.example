# Orbit 노트북 모드(클라우드 서버가 오기 전, 노트북 Docker로 여러 계정이 함께 쓰는 서버).
#   cp .env.laptop.example .env.laptop && chmod 600 .env.laptop
#   docker compose -f docker-compose.prod.yml --env-file .env.laptop up -d --build
# 대표의 개발 백엔드(8000)·개발 DB(프로젝트 orbit)와 볼륨·포트·프로젝트 이름이 모두 다르다.
# 자세한 것은 docs/deploy.md '노트북 모드'.

# ── 분리와 주소 (바꾸지 않는다) ───────────────────────────────
COMPOSE_PROJECT_NAME=orbit-laptop
ENV_FILE=.env.laptop
# 이 노트북 안에서만 열린다. 확장은 http://127.0.0.1:8076 으로 빌드한다.
BIND_ADDR=127.0.0.1
HTTP_PORT=8076
HTTPS_PORT=8476
# ':80' 은 Caddy 가 인증서 없이 HTTP 로만 받는다는 뜻이다(노트북 전용).
ORBIT_DOMAIN=:80
# HTTP 전용이라 쓰이지 않지만 compose 가 값을 요구한다.
ACME_EMAIL=unused@localhost

# ── 비밀값 (값은 이 파일에만, 공용 서버 값과 다르게 새로 만든다) ──
# python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
AXK1_API_KEY=
# AXK1_BASE_URL=
# AXK1_MODEL=
FRIENDLI_API_KEY=
# FRIENDLI_BASE_URL=
# EXAONE_MODEL=
# KT — 폴백. 모델명은 KT_MODEL_NAME(예전 KT_MODEL 은 읽지 않는다).
KT_API_KEY=
# KT_BASE_URL=
# KT_MODEL_NAME=
UPSTAGE_API_KEY=
GOOGLE_CLIENT_ID=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30
SYNC_INTERVAL_MINUTES=10
CORS_ALLOW_ORIGINS=chrome-extension://aghgamoeifieijjckhpfkmhiibacnhml
