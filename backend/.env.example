# Orbit Backend 환경변수 예시 (실제 .env 는 커밋 금지)

# SKT A.X K1 — 요약·의도분석·리랭킹·채팅 primary
AXK1_API_KEY=
AXK1_BASE_URL=https://awf-gw.adot.ai
AXK1_MODEL=A.X-K1

# LG EXAONE (FriendliAI serverless, OpenAI 호환) — 클러스터링 primary
# 기본값: base_url=https://api.friendli.ai/serverless/v1, model=LGAI-EXAONE/K-EXAONE-236B-A23B
FRIENDLI_API_KEY=

# Upstage — embedding 전용
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# 데이터스토어
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
QDRANT_URL=http://localhost:6333
# 검색 점수 임계값 (기본 0.28 — eval/run_retrieval_eval.py 실측, DecisionLog 2026-08-05)
SEARCH_SCORE_THRESHOLD=0.28
# 자연어 열린 탭 resolver 임계값 (eval/run_tab_action_eval.py 실측)
TAB_ACTION_INTENT_SCORE_FLOOR=0.14
TAB_ACTION_INTENT_MARGIN=0.02
TAB_ACTION_MATCH_SCORE_FLOOR=0.20
TAB_ACTION_MATCH_MARGIN=0.06
ASSISTANT_ROUTE_NAVIGATION_FLOOR=0.14
ASSISTANT_ROUTE_NAVIGATION_MARGIN=0.02
ASSISTANT_ROUTE_RETRIEVAL_MARGIN=0.015
